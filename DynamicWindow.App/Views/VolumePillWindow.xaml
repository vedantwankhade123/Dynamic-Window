<Window
    x:Class="DynamicWindow.App.Views.VolumePillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI">

    <Grid x:Name="VolumeRoot" Background="Transparent">
        <Border Background="#000000" CornerRadius="23" Padding="14,6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="30" Height="30" CornerRadius="15" Padding="0"
                    Background="#1C1C22" BorderThickness="0" Foreground="#FFFFFF"
                    Command="{Binding ToggleMuteCommand}"
                    ToolTipService.ToolTip="Mute / Unmute">
                    <ic:SymbolIcon Symbol="{Binding SpeakerSymbol}" FontSize="14" />
                </Button>

                <Button
                    Grid.Column="1"
                    Width="28" Height="28" CornerRadius="14" Padding="0"
                    Background="#1C1C22" BorderThickness="0" Foreground="#FFFFFF"
                    Command="{Binding VolumeDownCommand}"
                    ToolTipService.ToolTip="Volume Down">
                    <ic:SymbolIcon Symbol="Subtract" FontSize="13" />
                </Button>

                <TextBlock
                    Grid.Column="2"
                    Text="Volume"
                    FontSize="12.5"
                    FontWeight="Medium"
                    Foreground="#FFFFFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="3"
                    Width="28" Height="28" CornerRadius="14" Padding="0"
                    Background="#1C1C22" BorderThickness="0" Foreground="#FFFFFF"
                    Command="{Binding VolumeUpCommand}"
                    ToolTipService.ToolTip="Volume Up">
                    <ic:SymbolIcon Symbol="Add" FontSize="13" />
                </Button>

                <Button
                    Grid.Column="4"
                    Width="28" Height="28" CornerRadius="14" Padding="0"
                    Background="#1C1C22" BorderThickness="0" Foreground="#9CA3AF"
                    Command="{Binding ToggleVolumeBarCommand}"
                    ToolTipService.ToolTip="Close">
                    <ic:SymbolIcon Symbol="Dismiss" FontSize="11" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
