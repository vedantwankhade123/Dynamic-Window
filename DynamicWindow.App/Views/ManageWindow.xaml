<Window
    x:Class="DynamicWindow.App.Views.ManageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:conv="using:DynamicWindow.App.Converters"
    xmlns:views="using:DynamicWindow.App.Views"
    Title="Dynamic Window">

    <Grid Background="#0A0A0D">
        <Grid.Resources>
            <conv:HexToBrushConverter x:Key="HexToBrush" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <!-- Custom Seamless Dark Title Bar -->
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (Drag Region + State Pills) -->
        <Grid Grid.Row="0" Background="#111114" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
            <Grid x:Name="CustomTitleBar" Background="Transparent" Padding="14,0">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="#000000" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <ic:SymbolIcon Symbol="Sparkle" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="Dynamic Window" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F7" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Pill Preview State Switcher (Centered, Interactive) -->
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1A1F"
                BorderBrush="#16FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Content="Compact" Padding="10,3" FontSize="11" CornerRadius="6" Background="Transparent" BorderThickness="0" Foreground="#E5E5EA" Command="{Binding CollapseCommand}" />
                    <Button Content="Expanded" Padding="10,3" FontSize="11" CornerRadius="6" Background="Transparent" BorderThickness="0" Foreground="#E5E5EA" Command="{Binding ToggleExpandCommand}" />
                    <Button Content="Dashboard" Padding="10,3" FontSize="11" CornerRadius="6" Background="Transparent" BorderThickness="0" Foreground="#E5E5EA" Command="{Binding OpenDashboardCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- macOS System Settings 2-Column Workspace -->
        <Grid x:Name="ManageWorkspace" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar (#111114) -->
            <Border Grid.Column="0" Background="#111114" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" Padding="12,14">
                <Grid>
                    <StackPanel Spacing="12">
                        <TextBox
                            PlaceholderText="Search"
                            FontSize="12.5"
                            CornerRadius="8"
                            Background="#1C1C21"
                            BorderBrush="#18FFFFFF"
                            Padding="10,6" />

                        <StackPanel Spacing="3">
                            <Button x:Name="NavOverview" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="#25252C" BorderThickness="0" Tag="Overview" Click="OnSectionNavClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#0A84FF">
                                        <ic:SymbolIcon Symbol="Home" FontSize="12" Foreground="#FFFFFF" />
                                    </Border>
                                    <TextBlock Text="Overview" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavPillStudio" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="PillStudio" Click="OnSectionNavClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#BF5AF2">
                                        <ic:SymbolIcon Symbol="Options" FontSize="12" Foreground="#FFFFFF" />
                                    </Border>
                                    <TextBlock Text="Pill Behavior" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavClipboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="Clipboard" Click="OnSectionNavClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#FF9F0A">
                                        <ic:SymbolIcon Symbol="ClipboardPaste" FontSize="12" Foreground="#FFFFFF" />
                                    </Border>
                                    <TextBlock Text="Clipboard" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavDefaults" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="Defaults" Click="OnSectionNavClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#30D158">
                                        <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="12" Foreground="#FFFFFF" />
                                    </Border>
                                    <TextBlock Text="Default Apps" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Button VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#636366">
                                <ic:SymbolIcon Symbol="Settings" FontSize="12" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="Advanced Settings" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Right Content Canvas (#0A0A0D) -->
            <ScrollViewer Grid.Column="1" Padding="28,22" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="22" MaxWidth="680" HorizontalAlignment="Stretch">

                    <!-- Page Header -->
                    <TextBlock x:Name="HeaderTitle" Text="Overview" FontSize="20" FontWeight="SemiBold" Foreground="#F5F5F7" />

                    <!-- 1. OVERVIEW SECTION -->
                    <StackPanel x:Name="OverviewSection" Spacing="18">
                        <!-- Grouped Card: Quick Timers & Windows Tools -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="4,0,0,0" />
                            <Border Background="#16161B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <!-- Row 1: Focus Timer -->
                                    <Grid Padding="14,11">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="7" Background="#24FF9F0A">
                                                <ic:SymbolIcon Symbol="Timer" FontSize="14" Foreground="#FF9F0A" />
                                            </Border>
                                            <StackPanel Spacing="0">
                                                <TextBlock Text="Focus Timer" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" />
                                                <TextBlock Text="Start a live countdown in the pill" FontSize="11.5" Foreground="#8E8E93" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="5m" Padding="10,4" FontSize="11.5" CornerRadius="7" Background="#24242B" BorderThickness="0" Foreground="#F5F5F7" Command="{Binding StartTimer5MinCommand}" />
                                            <Button Content="15m" Padding="10,4" FontSize="11.5" CornerRadius="7" Background="#24242B" BorderThickness="0" Foreground="#F5F5F7" Command="{Binding StartTimer15MinCommand}" />
                                            <Button Content="25m" Padding="10,4" FontSize="11.5" CornerRadius="7" Background="#24242B" BorderThickness="0" Foreground="#FF9F0A" Command="{Binding StartPomodoro25MinCommand}" />
                                            <Button Content="Stop" Padding="10,4" FontSize="11.5" CornerRadius="7" Background="#1C1C22" BorderThickness="0" Foreground="#8E8E93" Command="{Binding StopTimerCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#10FFFFFF" Margin="54,0,0,0" />

                                    <!-- Row 2: Windows Shortcuts -->
                                    <Grid Padding="14,11">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="7" Background="#240A84FF">
                                                <ic:SymbolIcon Symbol="Apps" FontSize="14" Foreground="#0A84FF" />
                                            </Border>
                                            <StackPanel Spacing="0">
                                                <TextBlock Text="Windows Utilities" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" />
                                                <TextBlock Text="Launch native system tools" FontSize="11.5" Foreground="#8E8E93" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Screenshot" Padding="10,4" FontSize="11.5" CornerRadius="7" Background="#24242B" BorderThickness="0" Foreground="#F5F5F7" Tag="snip" Click="OnQuickToolTagClick" />
                                            <Button Content="Sound" Padding="10,4" FontSize="11.5" CornerRadius="7" Background="#24242B" BorderThickness="0" Foreground="#F5F5F7" Tag="sound" Click="OnQuickToolTagClick" />
                                            <Button Content="Focus Assist" Padding="10,4" FontSize="11.5" CornerRadius="7" Background="#24242B" BorderThickness="0" Foreground="#F5F5F7" Tag="focus" Click="OnQuickToolTagClick" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Grouped Card: Live System Telemetry -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="SYSTEM TELEMETRY" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="4,0,0,0" />
                            <Border Background="#16161B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="CPU" FontSize="11.5" Foreground="#8E8E93" />
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="{Binding SystemStats.CpuUsagePercent}" FontSize="18" FontWeight="SemiBold" Foreground="#F5F5F7" />
                                            <TextBlock Text="%" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                        </StackPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemStats.CpuUsagePercent}" Height="3.5" CornerRadius="2" Foreground="#0A84FF" Background="#22FFFFFF" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Memory" FontSize="11.5" Foreground="#8E8E93" />
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock Text="{Binding SystemStats.RamUsedGb}" FontSize="18" FontWeight="SemiBold" Foreground="#F5F5F7" />
                                            <TextBlock Text="GB" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                        </StackPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemStats.RamUsagePercent}" Height="3.5" CornerRadius="2" Foreground="#BF5AF2" Background="#22FFFFFF" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Battery" FontSize="11.5" Foreground="#8E8E93" />
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="{Binding SystemStats.BatteryPercent}" FontSize="18" FontWeight="SemiBold" Foreground="#F5F5F7" />
                                            <TextBlock Text="%" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                        </StackPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemStats.BatteryPercent}" Height="3.5" CornerRadius="2" Foreground="#30D158" Background="#22FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Grouped Card: Active Live Activities -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="ACTIVE PILL ACTIVITIES" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="4,0,0,0" />
                            <ItemsControl ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#16161B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="11" Padding="14,10" Margin="0,0,0,6" Tag="{Binding Id}" Click="OnActivityFocusClick">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ic:SymbolIcon Grid.Column="0" Symbol="Pulse" FontSize="15" Foreground="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />
                                                <StackPanel Grid.Column="1" Spacing="0">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#8E8E93" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11.5" Foreground="#0A84FF" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- 2. PILL BEHAVIOR & APPEARANCE (Apple Grouped Inset Rows) -->
                    <StackPanel x:Name="PillStudioSection" Spacing="16" Visibility="Collapsed">
                        <Border Background="#16161B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <Grid Padding="14,10">
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="Enable Dynamic Window Pill" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" />
                                        <TextBlock Text="Keep the floating pill always on top" FontSize="11.5" Foreground="#8E8E93" />
                                    </StackPanel>
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.IsDynamicWindowEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Height="1" Fill="#10FFFFFF" Margin="14,0,0,0" />

                                <Grid Padding="14,10">
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="Hide over active windows" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" />
                                        <TextBlock Text="Keep the top edge clear when another window covers the island area." FontSize="11.5" Foreground="#8E8E93" />
                                    </StackPanel>
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.AutoDodgeBrowserTabs, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Height="1" Fill="#10FFFFFF" Margin="14,0,0,0" />

                                <Grid Padding="14,10">
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="Show Platform Logo" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" />
                                        <TextBlock Text="Display source app icon on the right side of media pills" FontSize="11.5" Foreground="#8E8E93" />
                                    </StackPanel>
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.ShowPlatformBadge, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Height="1" Fill="#10FFFFFF" Margin="14,0,0,0" />

                                <Grid Padding="14,10">
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="Click Outside to Collapse" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" />
                                        <TextBlock Text="Return to compact pill when switching windows" FontSize="11.5" Foreground="#8E8E93" />
                                    </StackPanel>
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.ClickOutsideToCollapse, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#16161B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel Spacing="10">
                                <Slider Header="Compact Width (px)" Minimum="180" Maximum="300" StepFrequency="4" Value="{Binding Settings.CompactWidth, Mode=TwoWay}" />
                                <Slider Header="Compact Height (px)" Minimum="36" Maximum="56" StepFrequency="2" Value="{Binding Settings.CompactHeight, Mode=TwoWay}" />
                                <Slider Header="Pill Opacity" Minimum="0.5" Maximum="1.0" StepFrequency="0.02" Value="{Binding Settings.DynamicWindowOpacity, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Button HorizontalAlignment="Right" Background="#0A84FF" Foreground="#FFFFFF" CornerRadius="8" Padding="16,7" FontWeight="Medium" Content="Save Changes" Command="{Binding SaveQuickSettingsCommand}" />
                    </StackPanel>

                    <!-- 3. CLIPBOARD HISTORY -->
                    <StackPanel x:Name="ClipboardSection" Spacing="12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Refresh" Padding="12,5" FontSize="12" CornerRadius="8" Background="#24242B" BorderThickness="0" Foreground="#F5F5F7" Command="{Binding RefreshClipboardCommand}" />
                            <Button Content="Clear" Padding="12,5" FontSize="12" CornerRadius="8" Background="#24242B" BorderThickness="0" Foreground="#F5F5F7" Command="{Binding ClearClipboardCommand}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ClipboardItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16161B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ic:SymbolIcon Grid.Column="0" Symbol="DocumentText" FontSize="15" Foreground="#FF9F0A" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12.5" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Copy" Padding="10,4" FontSize="11.5" CornerRadius="7" Background="#24242B" BorderThickness="0" Foreground="#F5F5F7" Tag="{Binding Text}" Click="OnCopyClipboardClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4. DEFAULT APPS / HANDLERS -->
                    <StackPanel x:Name="DefaultsSection" Spacing="16" Visibility="Collapsed">
                        <Border Background="#16161B" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <Grid Padding="14,10">
                                    <TextBlock Text="Default Media Overlay (Spotify, Chrome, Edge, VLC)" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" VerticalAlignment="Center" />
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.DefaultForMediaOverlay, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Height="1" Fill="#10FFFFFF" Margin="14,0,0,0" />
                                <Grid Padding="14,10">
                                    <TextBlock Text="Default Focus &amp; Pomodoro Timer Pill" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" VerticalAlignment="Center" />
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.DefaultForTimers, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Height="1" Fill="#10FFFFFF" Margin="14,0,0,0" />
                                <Grid Padding="14,10">
                                    <TextBlock Text="Default Clipboard Quick Bar" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" VerticalAlignment="Center" />
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.DefaultForClipboardBar, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Height="1" Fill="#10FFFFFF" Margin="14,0,0,0" />
                                <Grid Padding="14,10">
                                    <TextBlock Text="Default Low Battery Alert Pill" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" VerticalAlignment="Center" />
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.DefaultForBatteryAlerts, Mode=TwoWay}" />
                                </Grid>
                                <Rectangle Height="1" Fill="#10FFFFFF" Margin="14,0,0,0" />
                                <Grid Padding="14,10">
                                    <TextBlock Text="Default Local AI Quick Prompt (Ollama)" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7" VerticalAlignment="Center" />
                                    <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.DefaultForAiPrompt, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button HorizontalAlignment="Right" Background="#0A84FF" Foreground="#FFFFFF" CornerRadius="8" Padding="16,7" FontWeight="Medium" Content="Save Defaults" Command="{Binding SaveQuickSettingsCommand}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <views:SettingsPanel x:Name="SettingsWorkspace" Grid.Row="1" Visibility="Collapsed" BackRequested="OnSettingsBackRequested" />
    </Grid>
</Window>
