<UserControl
    x:Class="DynamicWindow.App.Controls.DashboardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DynamicWindow.App.Controls"
    xmlns:conv="using:DynamicWindow.App.Converters">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid Padding="20,16,20,18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Dashboard Top Bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="12" Background="#1EFFFFFF">
                    <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{StaticResource DynamicWindowAccentBrush}" />
                </Border>
                <TextBlock Text="DynamicWindow Dashboard" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DynamicWindowTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button Style="{StaticResource DynamicWindowPillButtonStyle}" Command="{Binding OpenManageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE9E9;" FontSize="10.5" Foreground="{StaticResource DynamicWindowAccentBrush}" />
                        <TextBlock Text="Manage" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DynamicWindowIconButtonStyle}" Width="28" Height="28" Command="{Binding OpenSettingsCommand}" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource DynamicWindowIconButtonStyle}" Width="28" Height="28" Command="{Binding CollapseCommand}" ToolTipService.ToolTip="Collapse">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Dashboard Content Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Music / Active Activities + System Monitor -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <!-- Active Activities -->
                    <Border
                        Background="{StaticResource DynamicWindowCardGradientBrush}"
                        BorderBrush="{StaticResource DynamicWindowBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="LIVE ACTIVITIES" Style="{StaticResource DynamicWindowSectionHeaderStyle}" />
                                <TextBlock Text="Click to focus" FontSize="10" Foreground="{StaticResource DynamicWindowTextMutedBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="#12FFFFFF"
                                            BorderBrush="#16FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,8"
                                            Margin="0,0,0,6"
                                            Tag="{Binding Id}"
                                            Click="OnActivityCardClick">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    Glyph="{Binding IconGlyph}"
                                                    FontSize="14"
                                                    Foreground="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DynamicWindowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource DynamicWindowTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" Foreground="{StaticResource DynamicWindowTextMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- System Monitoring Widget -->
                    <controls:SystemMonitorCard />

                    <!-- Quick Controls Center -->
                    <Border
                        Background="{StaticResource DynamicWindowCardGradientBrush}"
                        BorderBrush="{StaticResource DynamicWindowBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="QUICK CONTROLS" Style="{StaticResource DynamicWindowSectionHeaderStyle}" />
                                <TextBlock Text="Windows Tools" FontSize="10" Foreground="{StaticResource DynamicWindowTextMutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding QuickControls}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="112" ItemHeight="56" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="3"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="#14FFFFFF"
                                            BorderBrush="#1AFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,6"
                                            Click="OnQuickControlClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="14" Foreground="{StaticResource DynamicWindowAccentBrush}" />
                                                <StackPanel Spacing="0">
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource DynamicWindowTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="{StaticResource DynamicWindowTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Notifications + AI Assistant -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <!-- Recent Notifications -->
                    <Border
                        Background="{StaticResource DynamicWindowCardGradientBrush}"
                        BorderBrush="{StaticResource DynamicWindowBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="NOTIFICATIONS" Style="{StaticResource DynamicWindowSectionHeaderStyle}" VerticalAlignment="Center" />
                                <Button
                                    Content="Clear"
                                    Style="{StaticResource DynamicWindowPillButtonStyle}"
                                    Padding="8,2"
                                    FontSize="10"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearNotificationsCommand}" />
                            </Grid>

                            <ScrollViewer MaxHeight="185" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Notifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="#12FFFFFF"
                                                BorderBrush="#16FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        Grid.Column="0"
                                                        Glyph="{Binding IconGlyph}"
                                                        FontSize="13"
                                                        VerticalAlignment="Top"
                                                        Margin="0,2,0,0"
                                                        Foreground="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource DynamicWindowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Message}" FontSize="10.5" Foreground="{StaticResource DynamicWindowTextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="2"
                                                        Style="{StaticResource DynamicWindowIconButtonStyle}"
                                                        Width="22" Height="22"
                                                        Tag="{Binding Id}"
                                                        Click="OnDismissNotificationClick"
                                                        ToolTipService.ToolTip="Dismiss">
                                                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- AI Assistant -->
                    <controls:AiAssistantControl />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
