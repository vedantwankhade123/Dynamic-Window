<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Global Outfit Typography -->
    <FontFamily x:Key="DynamicWindowFontFamily">ms-appx:///Assets/Fonts/Outfit.ttf#Outfit</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Outfit.ttf#Outfit</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DynamicWindowFontFamily}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DynamicWindowFontFamily}" />
    </Style>
    <Style TargetType="MenuFlyoutItem">
        <Setter Property="FontFamily" Value="{StaticResource DynamicWindowFontFamily}" />
    </Style>

    <!-- DynamicWindow Core Palette -->
    <Color x:Key="DynamicWindowVoidBlack">#070709</Color>
    <Color x:Key="DynamicWindowSurfaceDeep">#0B0B0F</Color>
    <Color x:Key="DynamicWindowSurfaceElevated">#14141A</Color>
    <Color x:Key="DynamicWindowSurfaceCard">#1B1B23</Color>
    <Color x:Key="DynamicWindowSurfaceHover">#24242F</Color>
    <Color x:Key="DynamicWindowBorderSubtle">#1EFFFFFF</Color>
    <Color x:Key="DynamicWindowBorderHighlight">#33FFFFFF</Color>
    <Color x:Key="DynamicWindowAccentBlue">#60A5FA</Color>
    <Color x:Key="DynamicWindowAccentIndigo">#818CF8</Color>
    <Color x:Key="DynamicWindowAccentGreen">#34D399</Color>
    <Color x:Key="DynamicWindowAccentAmber">#F59E0B</Color>
    <Color x:Key="DynamicWindowAccentRose">#FB7185</Color>

    <SolidColorBrush x:Key="DynamicWindowVoidBrush" Color="{StaticResource DynamicWindowVoidBlack}" />
    <SolidColorBrush x:Key="DynamicWindowSurfaceBrush" Color="{StaticResource DynamicWindowSurfaceDeep}" />
    <SolidColorBrush x:Key="DynamicWindowElevatedBrush" Color="{StaticResource DynamicWindowSurfaceElevated}" />
    <SolidColorBrush x:Key="DynamicWindowCardBrush" Color="{StaticResource DynamicWindowSurfaceCard}" />
    <SolidColorBrush x:Key="DynamicWindowHoverBrush" Color="{StaticResource DynamicWindowSurfaceHover}" />
    <SolidColorBrush x:Key="DynamicWindowBorderBrush" Color="{StaticResource DynamicWindowBorderSubtle}" />
    <SolidColorBrush x:Key="DynamicWindowAccentBrush" Color="{StaticResource DynamicWindowAccentBlue}" />
    <SolidColorBrush x:Key="DynamicWindowIndigoBrush" Color="{StaticResource DynamicWindowAccentIndigo}" />
    <SolidColorBrush x:Key="DynamicWindowGreenBrush" Color="{StaticResource DynamicWindowAccentGreen}" />
    <SolidColorBrush x:Key="DynamicWindowAmberBrush" Color="{StaticResource DynamicWindowAccentAmber}" />
    <SolidColorBrush x:Key="DynamicWindowRoseBrush" Color="{StaticResource DynamicWindowAccentRose}" />

    <SolidColorBrush x:Key="DynamicWindowTextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="DynamicWindowTextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DynamicWindowTextMutedBrush" Color="#64748B" />

    <LinearGradientBrush x:Key="DynamicWindowPillBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#000000" Offset="0" />
        <GradientStop Color="#050507" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DynamicWindowCardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1A22" Offset="0" />
        <GradientStop Color="#121218" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <Style x:Key="DynamicWindowTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DynamicWindowTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DynamicWindowSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DynamicWindowTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DynamicWindowSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DynamicWindowTextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <!-- Subtle Icon Button -->
    <Style x:Key="DynamicWindowIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource DynamicWindowTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#18FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DynamicWindowPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource DynamicWindowTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
</ResourceDictionary>
