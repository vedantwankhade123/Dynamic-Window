<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Global Outfit Typography -->
    <FontFamily x:Key="NewtonFontFamily">ms-appx:///Assets/Fonts/Outfit.ttf#Outfit</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Outfit.ttf#Outfit</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NewtonFontFamily}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource NewtonFontFamily}" />
    </Style>
    <Style TargetType="MenuFlyoutItem">
        <Setter Property="FontFamily" Value="{StaticResource NewtonFontFamily}" />
    </Style>

    <!-- Newton Core Palette -->
    <Color x:Key="NewtonVoidBlack">#070709</Color>
    <Color x:Key="NewtonSurfaceDeep">#0B0B0F</Color>
    <Color x:Key="NewtonSurfaceElevated">#14141A</Color>
    <Color x:Key="NewtonSurfaceCard">#1B1B23</Color>
    <Color x:Key="NewtonSurfaceHover">#24242F</Color>
    <Color x:Key="NewtonBorderSubtle">#1EFFFFFF</Color>
    <Color x:Key="NewtonBorderHighlight">#33FFFFFF</Color>
    <Color x:Key="NewtonAccentBlue">#60A5FA</Color>
    <Color x:Key="NewtonAccentIndigo">#818CF8</Color>
    <Color x:Key="NewtonAccentGreen">#34D399</Color>
    <Color x:Key="NewtonAccentAmber">#F59E0B</Color>
    <Color x:Key="NewtonAccentRose">#FB7185</Color>

    <SolidColorBrush x:Key="NewtonVoidBrush" Color="{StaticResource NewtonVoidBlack}" />
    <SolidColorBrush x:Key="NewtonSurfaceBrush" Color="{StaticResource NewtonSurfaceDeep}" />
    <SolidColorBrush x:Key="NewtonElevatedBrush" Color="{StaticResource NewtonSurfaceElevated}" />
    <SolidColorBrush x:Key="NewtonCardBrush" Color="{StaticResource NewtonSurfaceCard}" />
    <SolidColorBrush x:Key="NewtonHoverBrush" Color="{StaticResource NewtonSurfaceHover}" />
    <SolidColorBrush x:Key="NewtonBorderBrush" Color="{StaticResource NewtonBorderSubtle}" />
    <SolidColorBrush x:Key="NewtonAccentBrush" Color="{StaticResource NewtonAccentBlue}" />
    <SolidColorBrush x:Key="NewtonIndigoBrush" Color="{StaticResource NewtonAccentIndigo}" />
    <SolidColorBrush x:Key="NewtonGreenBrush" Color="{StaticResource NewtonAccentGreen}" />
    <SolidColorBrush x:Key="NewtonAmberBrush" Color="{StaticResource NewtonAccentAmber}" />
    <SolidColorBrush x:Key="NewtonRoseBrush" Color="{StaticResource NewtonAccentRose}" />

    <SolidColorBrush x:Key="NewtonTextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="NewtonTextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="NewtonTextMutedBrush" Color="#64748B" />

    <LinearGradientBrush x:Key="NewtonPillBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#000000" Offset="0" />
        <GradientStop Color="#050507" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NewtonCardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1A22" Offset="0" />
        <GradientStop Color="#121218" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <Style x:Key="NewtonTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NewtonTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NewtonSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NewtonTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NewtonSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NewtonTextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <!-- Subtle Icon Button -->
    <Style x:Key="NewtonIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource NewtonTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#18FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="NewtonPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource NewtonTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
</ResourceDictionary>
