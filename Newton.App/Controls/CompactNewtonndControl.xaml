<UserControl
    x:Class="Newton.App.Controls.CompactNewtonndControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:conv="using:Newton.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid>
        <!-- Subtle Music-Synced Gradient Strip in Compact Pill -->
        <Border CornerRadius="22" Visibility="{Binding IsMusicPrimary, Converter={StaticResource BoolToVis}}">
            <Border.Background>
                <LinearGradientBrush x:Name="CompactGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#000000" Offset="0.0" />
                    <GradientStop Color="#000000" Offset="0.45" />
                    <GradientStop x:Name="CompactGlowStop" Color="#5588242A" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Padding="12,5" ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Real Album Art / Content-Specific Symbol -->
            <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                <Border
                    CornerRadius="14"
                    Background="#1A1A20"
                    Visibility="{Binding HasCompactArtwork, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <ic:SymbolIcon
                        Symbol="{Binding CompactSymbol}"
                        FontSize="14"
                        Foreground="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}" />
                </Border>

                <Border
                    CornerRadius="14"
                    Visibility="{Binding HasCompactArtwork, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding CompactArtworkPath}" Stretch="UniformToFill" />
                </Border>
            </Grid>

            <!-- Center Title & Subtitle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                <TextBlock
                    Text="{Binding CompactTitle}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
                <TextBlock
                    Text="{Binding CompactSubtitle}"
                    FontSize="10"
                    Foreground="#9CA3AF"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </StackPanel>

            <!-- Horizontal Hover-Expand Quick Controls (Play/Pause, Previous, Forward) -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Visibility="{Binding IsHoverPeek, Converter={StaticResource BoolToVis}}">
                <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#1C1C22" BorderThickness="0" Foreground="#FFFFFF" Command="{Binding PreviousTrackCommand}" ToolTipService.ToolTip="Previous">
                    <ic:SymbolIcon Symbol="Previous" FontSize="12" />
                </Button>
                <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#2C2C35" BorderThickness="0" Foreground="#FFFFFF" Command="{Binding TogglePlayPauseCommand}" ToolTipService.ToolTip="Play / Pause">
                    <ic:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="12" />
                </Button>
                <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#1C1C22" BorderThickness="0" Foreground="#FFFFFF" Command="{Binding NextTrackCommand}" ToolTipService.ToolTip="Next">
                    <ic:SymbolIcon Symbol="Next" FontSize="12" />
                </Button>
                <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#1C1C22" BorderThickness="0" Foreground="#30D158" Command="{Binding OpenTackShelfCommand}" ToolTipService.ToolTip="Tack Shelf">
                    <ic:SymbolIcon Symbol="ClipboardPaste" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- Right: Platform Logo / Progress Ring (No Waveform) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0,0,0">
                <Border
                    Width="20" Height="20" CornerRadius="10"
                    Background="#1FFFFFFF"
                    Visibility="{Binding HasPlatformIcon, Converter={StaticResource BoolToVis}}"
                    ToolTipService.ToolTip="{Binding PlatformLabel}">
                    <Image Source="{Binding PlatformIconPath}" Width="13" Height="13" Stretch="Uniform" />
                </Border>

                <ProgressRing
                    Width="18"
                    Height="18"
                    IsIndeterminate="False"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding CompactProgress}"
                    Foreground="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}"
                    Visibility="{Binding IsNonMusicPrimary, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
