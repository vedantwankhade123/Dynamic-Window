<UserControl
    x:Class="Newton.App.Controls.CompactNewtonndControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Newton.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid Padding="14,6" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Activity Icon / Newton Mark -->
        <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
            <Border
                CornerRadius="13"
                Background="#1AFFFFFF"
                BorderBrush="#24FFFFFF"
                BorderThickness="1">
                <FontIcon
                    Glyph="{Binding PrimaryActivity.IconGlyph, FallbackValue='&#xE8D6;'}"
                    FontSize="12"
                    Foreground="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}" />
            </Border>
            <!-- Subtle live pulse dot -->
            <Ellipse
                Width="6"
                Height="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-1,-1,0"
                Fill="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}" />
        </Grid>

        <!-- Center Title & Subtle Subtitle -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
            <TextBlock
                Text="{Binding CompactTitle}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource NewtonTextPrimaryBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <TextBlock
                Text="{Binding CompactSubtitle}"
                FontSize="10"
                Foreground="{StaticResource NewtonTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
        </StackPanel>

        <!-- Right Indicator: Equalizer Bars or Progress Ring -->
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <!-- Animated Audio Bars (Music) -->
            <StackPanel
                x:Name="WaveformBars"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center"
                Visibility="{Binding IsMusicPrimary, Converter={StaticResource BoolToVis}}">
                <Rectangle x:Name="Bar1" Width="2.5" Height="10" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource NewtonAccentBrush}" VerticalAlignment="Bottom" />
                <Rectangle x:Name="Bar2" Width="2.5" Height="15" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource NewtonIndigoBrush}" VerticalAlignment="Bottom" />
                <Rectangle x:Name="Bar3" Width="2.5" Height="8" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource NewtonAccentBrush}" VerticalAlignment="Bottom" />
            </StackPanel>

            <!-- Progress Ring (Downloads / Timers / AI / Dev) -->
            <ProgressRing
                Width="18"
                Height="18"
                IsIndeterminate="False"
                Minimum="0"
                Maximum="100"
                Value="{Binding CompactProgress}"
                Foreground="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}"
                Visibility="{Binding IsNonMusicPrimary, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
