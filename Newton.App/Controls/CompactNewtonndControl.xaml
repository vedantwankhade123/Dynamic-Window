<UserControl
    x:Class="Newton.App.Controls.CompactNewtonndControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:conv="using:Newton.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid Padding="12,5" ColumnSpacing="9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Compact Pill Badge -->
        <Border
            Grid.Column="0"
            Width="26"
            Height="26"
            CornerRadius="13"
            VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#27272A" Offset="0" />
                    <GradientStop Color="#18181B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <ic:SymbolIcon
                Symbol="Sparkle"
                FontSize="14"
                Foreground="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}" />
        </Border>

        <!-- Center Title & Subtitle -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
            <TextBlock
                Text="{Binding CompactTitle}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#FFFFFF"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <TextBlock
                Text="{Binding CompactSubtitle}"
                FontSize="10"
                Foreground="#9CA3AF"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
        </StackPanel>

        <!-- Right Indicator: Dynamic Island Waveform or Progress Ring -->
        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0">
            <StackPanel
                x:Name="WaveformBars"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center"
                Visibility="{Binding IsMusicPrimary, Converter={StaticResource BoolToVis}}">
                <Rectangle x:Name="Bar1" Width="2.5" Height="9" RadiusX="1.2" RadiusY="1.2" Fill="#FB7185" VerticalAlignment="Center" />
                <Rectangle x:Name="Bar2" Width="2.5" Height="15" RadiusX="1.2" RadiusY="1.2" Fill="#A78BFA" VerticalAlignment="Center" />
                <Rectangle x:Name="Bar3" Width="2.5" Height="11" RadiusX="1.2" RadiusY="1.2" Fill="#818CF8" VerticalAlignment="Center" />
                <Rectangle x:Name="Bar4" Width="2.5" Height="7" RadiusX="1.2" RadiusY="1.2" Fill="#FB923C" VerticalAlignment="Center" />
            </StackPanel>

            <ProgressRing
                Width="18"
                Height="18"
                IsIndeterminate="False"
                Minimum="0"
                Maximum="100"
                Value="{Binding CompactProgress}"
                Foreground="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}"
                Visibility="{Binding IsNonMusicPrimary, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
