<UserControl
    x:Class="Newton.App.Controls.CompactNewtonndControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:conv="using:Newton.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid Padding="12,5" ColumnSpacing="9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left: Real Album Art / App Icon or Content-Specific Symbol -->
        <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
            <Border
                CornerRadius="8"
                Background="#1A1A20"
                Visibility="{Binding HasCompactArtwork, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <ic:SymbolIcon
                    Symbol="{Binding CompactSymbol}"
                    FontSize="14"
                    Foreground="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}" />
            </Border>

            <Border
                CornerRadius="8"
                Visibility="{Binding HasCompactArtwork, Converter={StaticResource BoolToVis}}">
                <Image Source="{Binding CompactArtworkPath}" Stretch="UniformToFill" />
            </Border>
        </Grid>

        <!-- Center Title & Subtitle -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
            <TextBlock
                Text="{Binding CompactTitle}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#FFFFFF"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <TextBlock
                Text="{Binding CompactSubtitle}"
                FontSize="10"
                Foreground="#9CA3AF"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
        </StackPanel>

        <!-- Horizontal Hover-Expand Quick Controls -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="4"
            VerticalAlignment="Center"
            Visibility="{Binding IsHoverPeek, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{Binding IsMusicPrimary, Converter={StaticResource BoolToVis}}">
                <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#1C1C22" BorderThickness="0" Foreground="#FFFFFF" Command="{Binding PreviousTrackCommand}" ToolTipService.ToolTip="Previous">
                    <ic:SymbolIcon Symbol="Previous" FontSize="12" />
                </Button>
                <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#2C2C35" BorderThickness="0" Foreground="#FFFFFF" Command="{Binding TogglePlayPauseCommand}" ToolTipService.ToolTip="Play / Pause">
                    <ic:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="12" />
                </Button>
                <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#1C1C22" BorderThickness="0" Foreground="#FFFFFF" Command="{Binding NextTrackCommand}" ToolTipService.ToolTip="Next">
                    <ic:SymbolIcon Symbol="Next" FontSize="12" />
                </Button>
            </StackPanel>
            <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#1C1C22" BorderThickness="0" Foreground="#9CA3AF" Command="{Binding StartTimer5MinCommand}" ToolTipService.ToolTip="Quick 5m Timer">
                <ic:SymbolIcon Symbol="Timer" FontSize="12" />
            </Button>
            <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#1C1C22" BorderThickness="0" Foreground="#9CA3AF" Command="{Binding OpenManageCommand}" ToolTipService.ToolTip="Manage Newton">
                <ic:SymbolIcon Symbol="Wrench" FontSize="12" />
            </Button>
        </StackPanel>

        <!-- Right: Platform Logo + Smooth 6-Bar Waveform / Progress Ring -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="2,0,0,0">
            <Border
                Width="18" Height="18" CornerRadius="5"
                Visibility="{Binding HasPlatformIcon, Converter={StaticResource BoolToVis}}"
                ToolTipService.ToolTip="{Binding PlatformLabel}">
                <Image Source="{Binding PlatformIconPath}" Stretch="Uniform" />
            </Border>

            <StackPanel
                x:Name="WaveformBars"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center"
                Visibility="{Binding IsMusicPrimary, Converter={StaticResource BoolToVis}}">
                <Rectangle x:Name="Bar1" Width="2.5" Height="6" RadiusX="1.2" RadiusY="1.2" Fill="#FB7185" VerticalAlignment="Center" />
                <Rectangle x:Name="Bar2" Width="2.5" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="#F472B6" VerticalAlignment="Center" />
                <Rectangle x:Name="Bar3" Width="2.5" Height="17" RadiusX="1.2" RadiusY="1.2" Fill="#A78BFA" VerticalAlignment="Center" />
                <Rectangle x:Name="Bar4" Width="2.5" Height="14" RadiusX="1.2" RadiusY="1.2" Fill="#818CF8" VerticalAlignment="Center" />
                <Rectangle x:Name="Bar5" Width="2.5" Height="10" RadiusX="1.2" RadiusY="1.2" Fill="#60A5FA" VerticalAlignment="Center" />
                <Rectangle x:Name="Bar6" Width="2.5" Height="6" RadiusX="1.2" RadiusY="1.2" Fill="#FB923C" VerticalAlignment="Center" />
            </StackPanel>

            <ProgressRing
                Width="18"
                Height="18"
                IsIndeterminate="False"
                Minimum="0"
                Maximum="100"
                Value="{Binding CompactProgress}"
                Foreground="{Binding PrimaryActivity.AccentHex, Converter={StaticResource HexToBrush}, FallbackValue='#60A5FA'}"
                Visibility="{Binding IsNonMusicPrimary, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
