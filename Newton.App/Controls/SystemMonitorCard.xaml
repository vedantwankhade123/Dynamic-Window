<UserControl
    x:Class="Newton.App.Controls.SystemMonitorCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{StaticResource NewtonCardGradientBrush}"
        BorderBrush="{StaticResource NewtonBorderBrush}"
        BorderThickness="1"
        CornerRadius="16"
        Padding="14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="SYSTEM OVERVIEW" Style="{StaticResource NewtonSectionHeaderStyle}" VerticalAlignment="Center" />
                <Border Background="#1434D399" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                    <TextBlock Text="LIVE" FontSize="9" FontWeight="SemiBold" Foreground="#34D399" />
                </Border>
            </Grid>

            <!-- CPU & RAM Row -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <Grid>
                        <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SystemStats.CpuUsagePercent}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NewtonTextPrimaryBrush}" />
                            <TextBlock Text="%" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemStats.CpuUsagePercent}" Height="4" CornerRadius="2" Foreground="#60A5FA" Background="#1FFFFFFF" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <Grid>
                        <TextBlock Text="RAM" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SystemStats.RamUsedGb}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NewtonTextPrimaryBrush}" />
                            <TextBlock Text=" GB" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemStats.RamUsagePercent}" Height="4" CornerRadius="2" Foreground="#818CF8" Background="#1FFFFFFF" />
                </StackPanel>
            </Grid>

            <!-- GPU & Battery Row -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <Grid>
                        <TextBlock Text="GPU" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <TextBlock Text="{Binding SystemStats.GpuUsagePercent}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NewtonTextPrimaryBrush}" />
                            <TextBlock Text="%" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                            <TextBlock Text="{Binding SystemStats.GpuTempCelsius}" FontSize="10.5" Foreground="#F59E0B" />
                            <TextBlock Text="°C" FontSize="10.5" Foreground="#F59E0B" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemStats.GpuUsagePercent}" Height="4" CornerRadius="2" Foreground="#34D399" Background="#1FFFFFFF" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <Grid>
                        <TextBlock Text="Battery" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SystemStats.BatteryPercent}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NewtonTextPrimaryBrush}" />
                            <TextBlock Text="%" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemStats.BatteryPercent}" Height="4" CornerRadius="2" Foreground="#34D399" Background="#1FFFFFFF" />
                </StackPanel>
            </Grid>

            <!-- Network Row -->
            <Grid Grid.Row="3" Padding="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="#34D399" />
                    <TextBlock Text="Down:" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                    <TextBlock Text="{Binding SystemStats.NetworkDownMbps}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NewtonTextPrimaryBrush}" />
                    <TextBlock Text="Mbps" FontSize="10.5" Foreground="{StaticResource NewtonTextMutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <FontIcon Glyph="&#xE898;" FontSize="11" Foreground="#60A5FA" />
                    <TextBlock Text="Up:" FontSize="11" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                    <TextBlock Text="{Binding SystemStats.NetworkUpMbps}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NewtonTextPrimaryBrush}" />
                    <TextBlock Text="Mbps" FontSize="10.5" Foreground="{StaticResource NewtonTextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
