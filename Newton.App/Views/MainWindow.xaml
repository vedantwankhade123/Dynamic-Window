<Window
    x:Class="Newton.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:controls="using:Newton.App.Controls"
    xmlns:conv="using:Newton.App.Converters">

    <Grid
        x:Name="RootShell"
        Background="Transparent"
        AllowDrop="True"
        DragOver="OnRootDragOver"
        DragLeave="OnRootDragLeave"
        Drop="OnRootDrop"
        PointerEntered="OnRootPointerEntered"
        PointerExited="OnRootPointerExited"
        PointerPressed="OnRootPointerPressed"
        PointerReleased="OnRootPointerReleased"
        DoubleTapped="OnRootDoubleTapped">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        </Grid.Resources>

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Toggle Expand" Command="{Binding ToggleExpandCommand}">
                    <MenuFlyoutItem.Icon><ic:SymbolIcon Symbol="ChevronDown" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open Dashboard" Command="{Binding OpenDashboardCommand}">
                    <MenuFlyoutItem.Icon><ic:SymbolIcon Symbol="Grid" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Manage Newton..." Command="{Binding OpenManageCommand}">
                    <MenuFlyoutItem.Icon><ic:SymbolIcon Symbol="Wrench" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Settings..." Command="{Binding OpenSettingsCommand}">
                    <MenuFlyoutItem.Icon><ic:SymbolIcon Symbol="Settings" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit Newton" Click="OnExitClick">
                    <MenuFlyoutItem.Icon><ic:SymbolIcon Symbol="Dismiss" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Main Pill / Card Surface -->
        <Border
            x:Name="NewtonndContainer"
            Background="{StaticResource NewtonPillBackgroundBrush}"
            BorderThickness="0"
            CornerRadius="23"
            RenderTransformOrigin="0.5,0">

            <Grid>
                <!-- Compact & Horizontal HoverPeek State -->
                <controls:CompactNewtonndControl
                    x:Name="CompactView"
                    Visibility="{Binding IsCompactOrHover, Converter={StaticResource BoolToVis}}" />

                <!-- Expanded State -->
                <controls:ExpandedNewtonndControl
                    x:Name="ExpandedView"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />

                <!-- Dashboard State -->
                <controls:DashboardControl
                    x:Name="DashboardView"
                    Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVis}}" />

                <!-- Tack Drop-Target Overlay -->
                <Border
                    CornerRadius="22"
                    Background="#E608120C"
                    BorderBrush="#30D158"
                    BorderThickness="1.5"
                    Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <ic:SymbolIcon Symbol="Pin" FontSize="15" Foreground="#30D158" />
                        <TextBlock Text="Drop to Tack to Newton" FontSize="12.5" FontWeight="SemiBold" Foreground="#30D158" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
