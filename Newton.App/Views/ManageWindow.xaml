<Window
    x:Class="Newton.App.Views.ManageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:conv="using:Newton.App.Converters"
    Title="Newton — Workspace &amp; Control Center">

    <Grid Background="#08080A">
        <Grid.Resources>
            <conv:HexToBrushConverter x:Key="HexToBrush" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <!-- Far-Left Narrow Icon Rail -->
            <ColumnDefinition Width="56" />
            <!-- Secondary Tree / Workspace Sidebar -->
            <ColumnDefinition Width="236" />
            <!-- Main Deep-Black Content Canvas -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. FAR-LEFT ICON RAIL -->
        <Border Grid.Column="0" Background="#0D0D11" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" Padding="0,16">
            <Grid>
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <!-- Newton Brand Mark -->
                    <Border Width="34" Height="34" CornerRadius="10" Background="#16161C" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,0,0,10">
                        <ic:SymbolIcon Symbol="Sparkle" FontSize="17" Foreground="#FFFFFF" />
                    </Border>

                    <Button Width="38" Height="38" CornerRadius="10" Padding="0" Background="#1E1E26" BorderThickness="0" Foreground="#FFFFFF" Tag="Overview" Click="OnSectionNavClick" ToolTipService.ToolTip="Workspace Overview">
                        <ic:SymbolIcon Symbol="Home" FontSize="17" />
                    </Button>
                    <Button Width="38" Height="38" CornerRadius="10" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Tag="PillStudio" Click="OnSectionNavClick" ToolTipService.ToolTip="Pill Studio &amp; Customization">
                        <ic:SymbolIcon Symbol="Options" FontSize="17" />
                    </Button>
                    <Button Width="38" Height="38" CornerRadius="10" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Tag="Clipboard" Click="OnSectionNavClick" ToolTipService.ToolTip="Clipboard History">
                        <ic:SymbolIcon Symbol="ClipboardPaste" FontSize="17" />
                    </Button>
                    <Button Width="38" Height="38" CornerRadius="10" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Tag="Defaults" Click="OnSectionNavClick" ToolTipService.ToolTip="Default Handlers">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="17" />
                    </Button>
                </StackPanel>

                <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="38" Height="38" CornerRadius="10" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Command="{Binding OpenSettingsCommand}" ToolTipService.ToolTip="All Settings">
                    <ic:SymbolIcon Symbol="Settings" FontSize="17" />
                </Button>
            </Grid>
        </Border>

        <!-- 2. SECONDARY WORKSPACE SIDEBAR -->
        <Border Grid.Column="1" Background="#0F0F13" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" Padding="14,16">
            <StackPanel Spacing="14">
                <Grid>
                    <TextBlock Text="Newton Workspace" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Width="26" Height="26" CornerRadius="7" Padding="0" Background="#191920" BorderThickness="0" Foreground="#9CA3AF" Command="{Binding StartTimer5MinCommand}" ToolTipService.ToolTip="Quick 5m Timer">
                        <ic:SymbolIcon Symbol="Add" FontSize="13" />
                    </Button>
                </Grid>

                <!-- Search Input -->
                <TextBox PlaceholderText="Search tools &amp; pills..." FontSize="12" CornerRadius="9" Background="#16161C" BorderBrush="#1EFFFFFF" />

                <!-- Segmented Switcher -->
                <Border Background="#15151B" CornerRadius="9" Padding="3" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="All Tools" HorizontalAlignment="Stretch" CornerRadius="7" Padding="0,5" FontSize="11.5" Background="#23232C" BorderThickness="0" Foreground="#FFFFFF" Tag="Overview" Click="OnSectionNavClick" />
                        <Button Grid.Column="1" Content="Defaults" HorizontalAlignment="Stretch" CornerRadius="7" Padding="0,5" FontSize="11.5" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Tag="Defaults" Click="OnSectionNavClick" />
                    </Grid>
                </Border>

                <!-- Tree Navigation Items -->
                <StackPanel Spacing="4">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8" Padding="10,7" Background="#1D1D25" BorderThickness="0" Tag="Overview" Click="OnSectionNavClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Folder" FontSize="14" Foreground="#E2E8F0" />
                                <TextBlock Text="Overview &amp; Pills" FontSize="12.5" Foreground="#FFFFFF" />
                            </StackPanel>
                            <Border Background="#2A2A35" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Activities.Count}" FontSize="10.5" Foreground="#CBD5E1" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="PillStudio" Click="OnSectionNavClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Options" FontSize="14" Foreground="#9CA3AF" />
                                <TextBlock Text="Pill Customization" FontSize="12.5" Foreground="#CBD5E1" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="Clipboard" Click="OnSectionNavClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="ClipboardPaste" FontSize="14" Foreground="#9CA3AF" />
                                <TextBlock Text="Clipboard History" FontSize="12.5" Foreground="#CBD5E1" />
                            </StackPanel>
                            <Border Background="#1D1D25" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ClipboardItems.Count}" FontSize="10.5" Foreground="#94A3B8" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="Defaults" Click="OnSectionNavClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="14" Foreground="#9CA3AF" />
                                <TextBlock Text="Default Handlers" FontSize="12.5" Foreground="#CBD5E1" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. MAIN CONTENT CANVAS -->
        <Grid Grid.Column="2" Background="#08080A" Padding="24,18" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Breadcrumb + Pill State Switcher -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="Overview &amp; Pills" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <Border Background="#18181F" CornerRadius="6" Padding="7,2">
                        <TextBlock Text="Always On Top" FontSize="10.5" Foreground="#60A5FA" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Content="Compact" Style="{StaticResource NewtonPillButtonStyle}" Command="{Binding CollapseCommand}" />
                    <Button Content="Expanded" Style="{StaticResource NewtonPillButtonStyle}" Command="{Binding ToggleExpandCommand}" />
                    <Button Content="Dashboard" Style="{StaticResource NewtonPillButtonStyle}" Command="{Binding OpenDashboardCommand}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="22">

                    <!-- SECTION: OVERVIEW & PILLS (Folder-style dark cards + Live Activities + Timers + Telemetry) -->
                    <StackPanel x:Name="OverviewSection" Spacing="20">
                        <TextBlock Text="Pill Modules" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />

                        <!-- Folder-Style Module Cards (Inspired by Reference) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Focus Timers -->
                            <Border Grid.Column="0" Background="#141418" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="14" Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#24F59E0B">
                                            <ic:SymbolIcon Symbol="Timer" FontSize="19" Foreground="#F59E0B" />
                                        </Border>
                                        <Button HorizontalAlignment="Right" Content="5m" Style="{StaticResource NewtonPillButtonStyle}" Padding="8,3" Command="{Binding StartTimer5MinCommand}" />
                                    </Grid>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Focus Timers" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Pomodoro &amp; countdowns" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="15m" Style="{StaticResource NewtonPillButtonStyle}" Padding="8,3" Command="{Binding StartTimer15MinCommand}" />
                                        <Button Content="25m" Style="{StaticResource NewtonPillButtonStyle}" Padding="8,3" Command="{Binding StartPomodoro25MinCommand}" />
                                        <Button Content="Stop" Style="{StaticResource NewtonPillButtonStyle}" Padding="8,3" Command="{Binding StopTimerCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: System Telemetry -->
                            <Border Grid.Column="1" Background="#141418" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="14" Padding="14">
                                <StackPanel Spacing="10">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#1F34D399" HorizontalAlignment="Left">
                                        <ic:SymbolIcon Symbol="DeveloperBoard" FontSize="19" Foreground="#34D399" />
                                    </Border>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="System Health" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="CPU" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SystemStats.CpuUsagePercent}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="%  •  RAM" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SystemStats.RamUsedGb}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="GB" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemStats.CpuUsagePercent}" Height="4" CornerRadius="2" Foreground="#34D399" Background="#22FFFFFF" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Quick Windows Tools -->
                            <Border Grid.Column="2" Background="#141418" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="14" Padding="14">
                                <StackPanel Spacing="10">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#1F60A5FA" HorizontalAlignment="Left">
                                        <ic:SymbolIcon Symbol="Apps" FontSize="19" Foreground="#60A5FA" />
                                    </Border>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Windows Tools" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Snipping, Sound, Bluetooth" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Snip" Style="{StaticResource NewtonPillButtonStyle}" Padding="8,3" Tag="snip" Click="OnQuickToolTagClick" />
                                        <Button Content="Sound" Style="{StaticResource NewtonPillButtonStyle}" Padding="8,3" Tag="sound" Click="OnQuickToolTagClick" />
                                        <Button Content="Focus" Style="{StaticResource NewtonPillButtonStyle}" Padding="8,3" Tag="focus" Click="OnQuickToolTagClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Active Live Activities Table -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Active Live Activities" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" />
                            <ItemsControl ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#121216" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6" Tag="{Binding Id}" Click="OnActivityFocusClick">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ic:SymbolIcon Grid.Column="0" Symbol="Pulse" FontSize="15" Foreground="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#94A3B8" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="#60A5FA" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- SECTION: PILL CUSTOMIZATION -->
                    <StackPanel x:Name="PillStudioSection" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Pill UI &amp; Behavior Customization" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <Border Background="#121216" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="18">
                            <StackPanel Spacing="12">
                                <ToggleSwitch Header="Enable Newton Pill (Always On Top)" IsOn="{Binding Settings.IsNewtonndEnabled, Mode=TwoWay}" />
                                <ToggleSwitch Header="Expand Horizontally on Hover (Quick Controls)" IsOn="{Binding Settings.HoverToPeek, Mode=TwoWay}" />
                                <ToggleSwitch Header="Show Platform Logo on Right (Spotify, Chrome, etc.)" IsOn="{Binding Settings.ShowPlatformBadge, Mode=TwoWay}" />
                                <ToggleSwitch Header="Click Outside to Collapse" IsOn="{Binding Settings.ClickOutsideToCollapse, Mode=TwoWay}" />
                                <ToggleSwitch Header="Drag to Reposition" IsOn="{Binding Settings.DragToReposition, Mode=TwoWay}" />
                                <Slider Header="Compact Width (px)" Minimum="180" Maximum="300" StepFrequency="4" Value="{Binding Settings.CompactWidth, Mode=TwoWay}" />
                                <Slider Header="Hover-Expanded Width (px)" Minimum="280" Maximum="460" StepFrequency="8" Value="{Binding Settings.HoverPeekWidth, Mode=TwoWay}" />
                                <Slider Header="Compact Height (px)" Minimum="36" Maximum="56" StepFrequency="2" Value="{Binding Settings.CompactHeight, Mode=TwoWay}" />
                                <Slider Header="Pill Opacity" Minimum="0.5" Maximum="1.0" StepFrequency="0.02" Value="{Binding Settings.NewtonndOpacity, Mode=TwoWay}" />
                                <Button HorizontalAlignment="Right" Background="{StaticResource NewtonAccentBrush}" Foreground="#070709" CornerRadius="12" Padding="14,7" FontWeight="SemiBold" Content="Save Pill Settings" Command="{Binding SaveQuickSettingsCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECTION: CLIPBOARD HISTORY -->
                    <StackPanel x:Name="ClipboardSection" Spacing="12" Visibility="Collapsed">
                        <Grid>
                            <TextBlock Text="Windows Clipboard History" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Refresh" Style="{StaticResource NewtonPillButtonStyle}" Command="{Binding RefreshClipboardCommand}" />
                                <Button Content="Clear" Style="{StaticResource NewtonPillButtonStyle}" Command="{Binding ClearClipboardCommand}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ClipboardItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#121216" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ic:SymbolIcon Grid.Column="0" Symbol="DocumentText" FontSize="15" Foreground="#60A5FA" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12.5" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Copy" Style="{StaticResource NewtonPillButtonStyle}" Padding="10,4" Tag="{Binding Text}" Click="OnCopyClipboardClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- SECTION: DEFAULT HANDLERS -->
                    <StackPanel x:Name="DefaultsSection" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Set Newton as Default Companion" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="Choose which desktop overlays and quick tools Newton handles by default." FontSize="12" Foreground="#94A3B8" />
                        <Border Background="#121216" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="18">
                            <StackPanel Spacing="12">
                                <ToggleSwitch Header="Default Media Overlay (Spotify, Chrome, Edge, VLC)" IsOn="{Binding Settings.DefaultForMediaOverlay, Mode=TwoWay}" />
                                <ToggleSwitch Header="Default Focus &amp; Pomodoro Timer Pill" IsOn="{Binding Settings.DefaultForTimers, Mode=TwoWay}" />
                                <ToggleSwitch Header="Default Clipboard History Quick Bar" IsOn="{Binding Settings.DefaultForClipboardBar, Mode=TwoWay}" />
                                <ToggleSwitch Header="Default Low Battery Alert Pill" IsOn="{Binding Settings.DefaultForBatteryAlerts, Mode=TwoWay}" />
                                <ToggleSwitch Header="Default Local AI Quick Prompt (Ollama)" IsOn="{Binding Settings.DefaultForAiPrompt, Mode=TwoWay}" />
                                <Button HorizontalAlignment="Right" Background="{StaticResource NewtonAccentBrush}" Foreground="#070709" CornerRadius="12" Padding="14,7" FontWeight="SemiBold" Content="Save Default Preferences" Command="{Binding SaveQuickSettingsCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
