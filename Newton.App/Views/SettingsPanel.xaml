<UserControl
    x:Class="Newton.App.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI">

    <Grid Background="#101114">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Seamless Dark Title Bar -->
        <Grid Grid.Row="0" x:Name="SettingsTitleBar" Background="#B31C1C20" BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹  Back to Newton" Click="OnBackRequested" Padding="8,4" CornerRadius="12" Background="#241C1C20" BorderBrush="#24FFFFFF" BorderThickness="1" Foreground="#0A84FF" FontSize="12" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Width="18" Height="18" CornerRadius="5" Background="#000000" BorderBrush="#26FFFFFF" BorderThickness="1">
                    <ic:SymbolIcon Symbol="Sparkle" FontSize="10" Foreground="#FFFFFF" />
                </Border>
                <TextBlock Text="Settings" FontSize="12.5" FontWeight="SemiBold" Foreground="#F5F5F7" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 3-Column Untitled UI Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Far-Left Narrow Icon Rail -->
            <Border Grid.Column="0" Visibility="Collapsed" Background="#111114" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" Padding="0,14">
                <Grid>
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Button Width="34" Height="34" CornerRadius="8" Padding="0" Background="#1A1A20" BorderBrush="#1EFFFFFF" BorderThickness="1" Foreground="#CBD5E1" Tag="General" Click="OnSectionClick" ToolTipService.ToolTip="General">
                            <ic:SymbolIcon Symbol="Add" FontSize="15" />
                        </Button>
                        <Button Width="34" Height="34" CornerRadius="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#8E8E93" Tag="General" Click="OnSectionClick" ToolTipService.ToolTip="General">
                            <ic:SymbolIcon Symbol="Home" FontSize="16" />
                        </Button>
                        <Button Width="34" Height="34" CornerRadius="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#8E8E93" Tag="Appearance" Click="OnSectionClick" ToolTipService.ToolTip="Appearance">
                            <ic:SymbolIcon Symbol="Layer" FontSize="16" />
                        </Button>
                        <Button Width="34" Height="34" CornerRadius="8" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#8E8E93" Tag="Activities" Click="OnSectionClick" ToolTipService.ToolTip="Activities">
                            <ic:SymbolIcon Symbol="Apps" FontSize="16" />
                        </Button>
                        <Button Width="34" Height="34" CornerRadius="8" Padding="0" Background="#25252D" BorderThickness="0" Foreground="#FFFFFF" Tag="Appearance" Click="OnSectionClick" ToolTipService.ToolTip="Settings">
                            <ic:SymbolIcon Symbol="Settings" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <!-- Bottom Accent Dots -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,6">
                        <Ellipse Width="7" Height="7" Fill="#0A84FF" />
                        <Ellipse Width="7" Height="7" Fill="#30D158" />
                        <Ellipse Width="7" Height="7" Fill="#F472B6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Settings Sidebar -->
            <Border Grid.Column="1" Background="#B31C1C20" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" Padding="14,16">
                <StackPanel Spacing="14">
                    <!-- Brand Header -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="28" Height="28" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0A84FF" Offset="0" />
                                    <GradientStop Color="#5E5CE6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ic:SymbolIcon Symbol="Sparkle" FontSize="13" Foreground="#FFFFFF" />
                        </Border>
                        <StackPanel Spacing="0">
                            <TextBlock Text="Newton" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F7" />
                            <TextBlock Text="Dynamic Island" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Foreground="#F5F5F7" Margin="2,4,0,0" />

                    <TextBox PlaceholderText="Search" FontSize="12.5" CornerRadius="12" Background="#2C2C2E" BorderBrush="#20FFFFFF" Padding="10,6" />

                    <StackPanel Spacing="3">
                        <Button x:Name="NavGeneral" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="#25252D" BorderThickness="0" Tag="General" Click="OnSectionClick">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <ic:SymbolIcon Symbol="Settings" FontSize="14" Foreground="#CBD5E1" />
                                <TextBlock Text="General" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAppearance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="Appearance" Click="OnSectionClick">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <ic:SymbolIcon Symbol="Sparkle" FontSize="14" Foreground="#CBD5E1" />
                                <TextBlock Text="Appearance" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPosition" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="Position" Click="OnSectionClick">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <ic:SymbolIcon Symbol="Desktop" FontSize="14" Foreground="#CBD5E1" />
                                <TextBlock Text="Position" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavInteractions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="Interactions" Click="OnSectionClick">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <ic:SymbolIcon Symbol="Cursor" FontSize="14" Foreground="#CBD5E1" />
                                <TextBlock Text="Interactions" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavActivities" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="Activities" Click="OnSectionClick">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <ic:SymbolIcon Symbol="Pulse" FontSize="14" Foreground="#CBD5E1" />
                                    <TextBlock Text="Activities" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" />
                                </StackPanel>
                                <Border Background="#24242C" CornerRadius="9" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="8" FontSize="10.5" Foreground="#CBD5E1" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="NavAi" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="AI" Click="OnSectionClick">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <ic:SymbolIcon Symbol="Bot" FontSize="14" Foreground="#CBD5E1" />
                                <TextBlock Text="AI Assistant" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAbout" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="0" Tag="About" Click="OnSectionClick">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <ic:SymbolIcon Symbol="Info" FontSize="14" Foreground="#CBD5E1" />
                                <TextBlock Text="About" FontSize="13" FontWeight="Medium" Foreground="#E5E5EA" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Main Settings Canvas -->
            <Grid Grid.Column="2" Padding="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,18">
                    <TextBlock x:Name="SectionTitle" Text="General settings" FontSize="22" FontWeight="SemiBold" Foreground="#F5F5F7" />
                    <TextBlock x:Name="SectionSubtitle" Text="Configure Newton startup, visibility, and language preferences." FontSize="12.5" Foreground="#8E8E93" />
                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,14,0,0" />
                </StackPanel>

                <!-- Scrollable Sections -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">

                        <!-- GENERAL -->
                        <StackPanel x:Name="GeneralPanel" Spacing="0">
                            <Grid Padding="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Enable Newton Pill" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                    <TextBlock Text="Keep the floating pill active at top center." FontSize="11.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.IsNewtonndEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Rectangle Height="1" Fill="#12FFFFFF" />

                            <Grid Padding="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Start with Windows" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                    <TextBlock Text="Launch Newton automatically at sign-in." FontSize="11.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.StartWithWindows, Mode=TwoWay}" />
                            </Grid>
                            <Rectangle Height="1" Fill="#12FFFFFF" />

                            <Grid Padding="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Language" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                    <TextBlock Text="Select interface display language." FontSize="11.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Settings.Language, Mode=TwoWay}" Width="240" CornerRadius="8" />
                            </Grid>
                        </StackPanel>

                        <!-- APPEARANCE (With Visual Theme Cards!) -->
                        <StackPanel x:Name="AppearancePanel" Spacing="0" Visibility="Collapsed">
                            <Grid Padding="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Interface theme" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                    <TextBlock Text="Select or customize your UI theme." FontSize="11.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <!-- System Card -->
                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Tag="2" Click="OnThemeCardClick">
                                        <StackPanel Spacing="6">
                                            <Border x:Name="ThemeCardSystem" Width="118" Height="74" CornerRadius="10" BorderBrush="#0A84FF" BorderThickness="2" Background="#1C1C1E">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#1C1C1E" CornerRadius="8,0,0,8" />
                                                    <Border Grid.Column="1" Background="#E5E7EB" CornerRadius="0,8,8,0" />
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#0A84FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                                                        <ic:SymbolIcon Symbol="Checkmark" FontSize="10" Foreground="#FFFFFF" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="System preference" FontSize="11.5" Foreground="#CBD5E1" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Dark Card -->
                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Tag="0" Click="OnThemeCardClick">
                                        <StackPanel Spacing="6">
                                            <Border x:Name="ThemeCardDark" Width="118" Height="74" CornerRadius="10" BorderBrush="#24FFFFFF" BorderThickness="1" Background="#111116">
                                                <StackPanel Margin="10" Spacing="5">
                                                    <Rectangle Height="6" Width="44" RadiusX="3" RadiusY="3" Fill="#2D2D38" HorizontalAlignment="Left" />
                                                    <Rectangle Height="28" RadiusX="4" RadiusY="4" Fill="#1B1B22" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Dark" FontSize="11.5" Foreground="#CBD5E1" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Light Card -->
                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Tag="1" Click="OnThemeCardClick">
                                        <StackPanel Spacing="6">
                                            <Border x:Name="ThemeCardLight" Width="118" Height="74" CornerRadius="10" BorderBrush="#24FFFFFF" BorderThickness="1" Background="#E5E7EB">
                                                <StackPanel Margin="10" Spacing="5">
                                                    <Rectangle Height="6" Width="44" RadiusX="3" RadiusY="3" Fill="#CBD5E1" HorizontalAlignment="Left" />
                                                    <Rectangle Height="28" RadiusX="4" RadiusY="4" Fill="#FFFFFF" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Light" FontSize="11.5" Foreground="#CBD5E1" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="#12FFFFFF" />

                            <Grid Padding="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Enable Blur / Translucency" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                    <TextBlock Text="Apply soft glass translucency where supported." FontSize="11.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding Settings.EnableBlur, Mode=TwoWay}" />
                            </Grid>
                            <Rectangle Height="1" Fill="#12FFFFFF" />

                            <Grid Padding="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Pill Dimensions &amp; Opacity" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                    <TextBlock Text="Fine-tune compact width, height, and opacity." FontSize="11.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" Width="300" HorizontalAlignment="Left">
                                    <Slider Header="Compact Width (px)" Minimum="180" Maximum="300" StepFrequency="4" Value="{Binding Settings.CompactWidth, Mode=TwoWay}" />
                                    <Slider Header="Compact Height (px)" Minimum="36" Maximum="56" StepFrequency="2" Value="{Binding Settings.CompactHeight, Mode=TwoWay}" />
                                    <Slider Header="Opacity" Minimum="0.5" Maximum="1.0" StepFrequency="0.02" Value="{Binding Settings.NewtonndOpacity, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- POSITION -->
                        <StackPanel x:Name="PositionPanel" Spacing="0" Visibility="Collapsed">
                            <Grid Padding="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Anchor Position" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                    <TextBlock Text="Choose where Newton sits on your display." FontSize="11.5" Foreground="#8E8E93" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding PositionIndex, Mode=TwoWay}" Width="240" CornerRadius="8">
                                    <ComboBoxItem Content="Top Center" />
                                    <ComboBoxItem Content="Top Left" />
                                    <ComboBoxItem Content="Top Right" />
                                    <ComboBoxItem Content="Custom" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Height="1" Fill="#12FFFFFF" />
                            <Grid Padding="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Offsets &amp; Monitor" FontSize="13" FontWeight="Medium" Foreground="#F5F5F7" />
                                    <TextBlock Text="Adjust horizontal/vertical margin and display index." FontSize="11.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" Width="300" HorizontalAlignment="Left">
                                    <Slider Header="Horizontal Offset (px)" Minimum="-400" Maximum="400" StepFrequency="4" Value="{Binding Settings.HorizontalOffset, Mode=TwoWay}" />
                                    <Slider Header="Vertical Offset (px)" Minimum="0" Maximum="120" StepFrequency="2" Value="{Binding Settings.VerticalOffset, Mode=TwoWay}" />
                                    <NumberBox Header="Monitor Index (0 = Primary)" Value="{Binding Settings.SelectedMonitorIndex, Mode=TwoWay}" Minimum="0" Maximum="4" Width="180" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- INTERACTIONS -->
                        <StackPanel x:Name="InteractionsPanel" Spacing="10" Visibility="Collapsed">
                            <ToggleSwitch Header="Hide when the active window overlaps the island" IsOn="{Binding Settings.AutoDodgeBrowserTabs, Mode=TwoWay}" />
                            <ToggleSwitch Header="Single-click to expand vertically" IsOn="{Binding Settings.ClickToExpand, Mode=TwoWay}" />
                            <ToggleSwitch Header="Double-click to open dashboard" IsOn="{Binding Settings.DoubleClickForDashboard, Mode=TwoWay}" />
                            <ToggleSwitch Header="Click outside to collapse" IsOn="{Binding Settings.ClickOutsideToCollapse, Mode=TwoWay}" />
                            <ToggleSwitch Header="Drag to reposition" IsOn="{Binding Settings.DragToReposition, Mode=TwoWay}" />
                            <TextBlock Text="Press Ctrl+N or move to the top edge to reveal a hidden live activity." FontSize="12" Foreground="#8E8E93" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- ACTIVITIES -->
                        <StackPanel x:Name="ActivitiesPanel" Spacing="10" Visibility="Collapsed">
                            <ToggleSwitch Header="Windows Media Playback" IsOn="{Binding Settings.EnableMusic, Mode=TwoWay}" />
                            <ToggleSwitch Header="Tack Clipboard &amp; Screenshot Capture" IsOn="{Binding Settings.EnableClipboardTracking, Mode=TwoWay}" />
                            <ToggleSwitch Header="Focus Timers &amp; Pomodoro" IsOn="{Binding Settings.EnableTimers, Mode=TwoWay}" />
                            <ToggleSwitch Header="Low Battery &amp; System Alerts" IsOn="{Binding Settings.EnableSystemOps, Mode=TwoWay}" />
                            <ToggleSwitch Header="Show Platform Logo on Media Pills" IsOn="{Binding Settings.ShowPlatformBadge, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- AI -->
                        <StackPanel x:Name="AiPanel" Spacing="12" Visibility="Collapsed">
                            <ToggleSwitch Header="Enable Local AI Features" IsOn="{Binding Settings.EnableAiFeatures, Mode=TwoWay}" />
                            <ComboBox Header="Provider" ItemsSource="{Binding AiProviders}" SelectedItem="{Binding Settings.DefaultAiProvider, Mode=TwoWay}" Width="260" />
                            <TextBox Header="Ollama Endpoint" Text="{Binding Settings.LocalEndpoint, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />
                            <TextBox Header="Default Model" Text="{Binding Settings.DefaultLocalModel, Mode=TwoWay}" Width="240" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- ABOUT -->
                        <StackPanel x:Name="AboutPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Newton — Dynamic Island for Windows" FontSize="16" FontWeight="SemiBold" Foreground="#F5F5F7" />
                            <TextBlock Text="It doesn't fall like an apple — it always sticks at the top." FontSize="13" Foreground="#A5B4FC" />
                            <TextBlock Text="Built natively with WinUI 3, Windows App SDK, .NET 8, MVVM, SQLite, Outfit, and FluentIcons.WinUI." FontSize="12.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                            <TextBlock Text="Repository: https://github.com/vedantwankhade123/Newton" FontSize="12" Foreground="#60A5FA" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Action Bar -->
                <Grid Grid.Row="2" Padding="0,16,0,0" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#30D158" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Reset" Padding="14,7" CornerRadius="8" Background="#1A1A20" BorderBrush="#1EFFFFFF" BorderThickness="1" Foreground="#E5E5EA" Command="{Binding ResetDefaultsCommand}" />
                        <Button Content="Save changes" Padding="16,7" CornerRadius="12" Background="#0A84FF" BorderThickness="0" Foreground="#FFFFFF" FontWeight="SemiBold" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
