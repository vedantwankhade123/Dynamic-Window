<Window
    x:Class="Newton.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Newton Settings">

    <Grid Background="{StaticResource NewtonSurfaceBrush}">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appearance" Tag="Appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Position" Tag="Position">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Interactions" Tag="Interactions">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9A9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activities" Tag="Activities">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI" Tag="AI">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="SectionTitle"
                    Grid.Row="0"
                    Text="General"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource NewtonTextPrimaryBrush}"
                    Margin="0,0,0,18" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">

                        <!-- GENERAL -->
                        <StackPanel x:Name="GeneralPanel" Spacing="12">
                            <ToggleSwitch Header="Enable Newton Newtonnd" IsOn="{Binding Settings.IsNewtonndEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Start Newton with Windows" IsOn="{Binding Settings.StartWithWindows, Mode=TwoWay}" />
                            <ToggleSwitch Header="Show on startup" IsOn="{Binding Settings.ShowOnStartup, Mode=TwoWay}" />
                            <ComboBox Header="Language" ItemsSource="{Binding Languages}" SelectedItem="{Binding Settings.Language, Mode=TwoWay}" Width="240" />
                            <Button Content="Check for Updates (Placeholder)" Style="{StaticResource NewtonPillButtonStyle}" />
                        </StackPanel>

                        <!-- APPEARANCE -->
                        <StackPanel x:Name="AppearancePanel" Spacing="12" Visibility="Collapsed">
                            <ComboBox Header="Theme" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" Width="240">
                                <ComboBoxItem Content="Dark (Default)" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="System" />
                            </ComboBox>
                            <Slider Header="Newtonnd Opacity" Minimum="0.5" Maximum="1.0" StepFrequency="0.02" Value="{Binding Settings.NewtonndOpacity, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" />
                            <Slider Header="Corner Radius" Minimum="12" Maximum="30" StepFrequency="1" Value="{Binding Settings.CornerRadius, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" />
                            <Slider Header="Compact Width (px)" Minimum="180" Maximum="300" StepFrequency="4" Value="{Binding Settings.CompactWidth, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" />
                            <Slider Header="Compact Height (px)" Minimum="38" Maximum="60" StepFrequency="2" Value="{Binding Settings.CompactHeight, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" />
                            <Slider Header="Animation Speed" Minimum="0.5" Maximum="2.0" StepFrequency="0.1" Value="{Binding Settings.AnimationSpeed, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" />
                            <ToggleSwitch Header="Enable Blur / Translucency" IsOn="{Binding Settings.EnableBlur, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- POSITION -->
                        <StackPanel x:Name="PositionPanel" Spacing="12" Visibility="Collapsed">
                            <ComboBox Header="Position Preset" SelectedIndex="{Binding PositionIndex, Mode=TwoWay}" Width="240">
                                <ComboBoxItem Content="Top Center" />
                                <ComboBoxItem Content="Top Left" />
                                <ComboBoxItem Content="Top Right" />
                                <ComboBoxItem Content="Custom" />
                            </ComboBox>
                            <Slider Header="Horizontal Offset (px)" Minimum="-400" Maximum="400" StepFrequency="4" Value="{Binding Settings.HorizontalOffset, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" />
                            <Slider Header="Vertical Offset (px)" Minimum="0" Maximum="120" StepFrequency="2" Value="{Binding Settings.VerticalOffset, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" />
                            <NumberBox Header="Target Monitor Index (0 = Primary)" Value="{Binding Settings.SelectedMonitorIndex, Mode=TwoWay}" Minimum="0" Maximum="4" Width="240" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- INTERACTIONS -->
                        <StackPanel x:Name="InteractionsPanel" Spacing="12" Visibility="Collapsed">
                            <ToggleSwitch Header="Single-click to expand" IsOn="{Binding Settings.ClickToExpand, Mode=TwoWay}" />
                            <ToggleSwitch Header="Double-click to open dashboard" IsOn="{Binding Settings.DoubleClickForDashboard, Mode=TwoWay}" />
                            <ToggleSwitch Header="Hover to peek" IsOn="{Binding Settings.HoverToPeek, Mode=TwoWay}" />
                            <ToggleSwitch Header="Click outside to collapse" IsOn="{Binding Settings.ClickOutsideToCollapse, Mode=TwoWay}" />
                            <ToggleSwitch Header="Drag to reposition" IsOn="{Binding Settings.DragToReposition, Mode=TwoWay}" />
                            <TextBox Header="Keyboard Shortcut" Text="{Binding Settings.ToggleShortcut, Mode=TwoWay}" Width="240" HorizontalAlignment="Left" />
                            <NumberBox Header="Auto-collapse delay (seconds, 0 = off)" Value="{Binding Settings.AutoCollapseSeconds, Mode=TwoWay}" Minimum="0" Maximum="120" Width="240" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- ACTIVITIES -->
                        <StackPanel x:Name="ActivitiesPanel" Spacing="12" Visibility="Collapsed">
                            <ToggleSwitch Header="Music Playback" IsOn="{Binding Settings.EnableMusic, Mode=TwoWay}" />
                            <ToggleSwitch Header="Downloads" IsOn="{Binding Settings.EnableDownloads, Mode=TwoWay}" />
                            <ToggleSwitch Header="Timers &amp; Pomodoro" IsOn="{Binding Settings.EnableTimers, Mode=TwoWay}" />
                            <ToggleSwitch Header="AI Generation Tasks" IsOn="{Binding Settings.EnableAi, Mode=TwoWay}" />
                            <ToggleSwitch Header="Notifications" IsOn="{Binding Settings.EnableNotifications, Mode=TwoWay}" />
                            <ToggleSwitch Header="System Operations" IsOn="{Binding Settings.EnableSystemOps, Mode=TwoWay}" />
                            <ToggleSwitch Header="Developer Activities" IsOn="{Binding Settings.EnableDevActivities, Mode=TwoWay}" />
                            <ToggleSwitch Header="Show progress indicator in Compact mode" IsOn="{Binding Settings.ShowProgressInCompact, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- AI -->
                        <StackPanel x:Name="AiPanel" Spacing="12" Visibility="Collapsed">
                            <ToggleSwitch Header="Enable AI features" IsOn="{Binding Settings.EnableAiFeatures, Mode=TwoWay}" />
                            <ComboBox Header="Default Provider" ItemsSource="{Binding AiProviders}" SelectedItem="{Binding Settings.DefaultAiProvider, Mode=TwoWay}" Width="260" />
                            <TextBox Header="Local Model Endpoint (Ollama / OpenAI-compatible)" Text="{Binding Settings.LocalEndpoint, Mode=TwoWay}" Width="340" HorizontalAlignment="Left" />
                            <TextBox Header="Default Local Model" Text="{Binding Settings.DefaultLocalModel, Mode=TwoWay}" Width="260" HorizontalAlignment="Left" />
                            <TextBox Header="Cloud Provider Configuration" Text="{Binding Settings.CloudProvider, Mode=TwoWay}" Width="260" HorizontalAlignment="Left" />
                            <ToggleSwitch Header="Share active newtonnd context with AI" IsOn="{Binding Settings.ShareActiveContextWithAi, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- ABOUT -->
                        <StackPanel x:Name="AboutPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Newton — Dynamic Newtonnd for Windows" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NewtonTextPrimaryBrush}" />
                            <TextBlock Text="Version 1.0.0-phase1 (UI &amp; Interaction Prototype)" FontSize="13" Foreground="{StaticResource NewtonTextSecondaryBrush}" />
                            <TextBlock Text="Built natively with WinUI 3, Windows App SDK, .NET 8, MVVM, and SQLite." FontSize="12.5" Foreground="{StaticResource NewtonTextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Open-source licenses: CommunityToolkit.Mvvm (MIT), Microsoft.Data.Sqlite (MIT), Microsoft.Extensions.* (MIT)." FontSize="12" Foreground="{StaticResource NewtonTextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="GitHub: https://github.com/newton-windows/newton (Placeholder)" FontSize="12" Foreground="{StaticResource NewtonAccentBrush}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Save / Reset -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource NewtonGreenBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Reset Defaults" Style="{StaticResource NewtonPillButtonStyle}" Command="{Binding ResetDefaultsCommand}" />
                        <Button Content="Save &amp; Apply" Background="{StaticResource NewtonAccentBrush}" Foreground="{StaticResource NewtonVoidBrush}" CornerRadius="14" Padding="14,6" FontWeight="SemiBold" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
