<Window
    x:Class="Isla.App.Views.DemoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Isla Windows Usecase Preview">

    <Grid Background="{StaticResource IslaSurfaceBrush}" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Isla Windows Usecase Preview" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource IslaTextPrimaryBrush}" />
            <TextBlock Text="Click any Windows usecase below to preview its Dynamic Island pill live at the top of your screen." FontSize="12" Foreground="{StaticResource IslaTextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">
                <TextBlock Text="ISLAND STATES" Style="{StaticResource IslaSectionHeaderStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Compact" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding CollapseCommand}" />
                    <Button Content="Expanded" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding ToggleExpandCommand}" />
                    <Button Content="Dashboard" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding OpenDashboardCommand}" />
                    <Button Content="Settings" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>

                <TextBlock Text="WINDOWS DYNAMIC ISLAND PILLS" Style="{StaticResource IslaSectionHeaderStyle}" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="Music Player Card" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoMusicCommand}" />
                    <Button Grid.Row="0" Grid.Column="1" Content="Focus Timer (90s)" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoTimerCommand}" />
                    <Button Grid.Row="1" Grid.Column="0" Content="Screen Recording" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoScreenRecordingCommand}" />
                    <Button Grid.Row="1" Grid.Column="1" Content="Focus Assist (DND)" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoFocusAssistCommand}" />
                    <Button Grid.Row="2" Grid.Column="0" Content="Low Battery Alert" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoLowBatteryCommand}" />
                    <Button Grid.Row="2" Grid.Column="1" Content="Bluetooth Connected" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoBluetoothCommand}" />
                    <Button Grid.Row="3" Grid.Column="0" Content="Teams Incoming Call" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoIncomingCallCommand}" />
                    <Button Grid.Row="3" Grid.Column="1" Content="SDK Download" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoDownloadCommand}" />
                    <Button Grid.Row="4" Grid.Column="0" Content="File Move (Explorer)" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoFileOpCommand}" />
                    <Button Grid.Row="4" Grid.Column="1" Content="Dev Build (Vite)" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoCustomDevCommand}" />
                    <Button Grid.Row="5" Grid.Column="0" Content="AI Task Streaming" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoAiTaskCommand}" />
                    <Button Grid.Row="5" Grid.Column="1" Content="App Install (VS Code)" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoAppInstallCommand}" />
                    <Button Grid.Row="6" Grid.Column="0" Content="Teams Notification" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoNotificationCommand}" CommandParameter="message" />
                    <Button Grid.Row="6" Grid.Column="1" Content="Reset Demo" HorizontalAlignment="Stretch" Style="{StaticResource IslaPillButtonStyle}" Command="{Binding DemoResetCommand}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
