<UserControl
    x:Class="Isla.App.Controls.AiAssistantControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{StaticResource IslaCardGradientBrush}"
        BorderBrush="{StaticResource IslaBorderBrush}"
        BorderThickness="1"
        CornerRadius="16"
        Padding="14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Model Header -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE99A;" FontSize="14" Foreground="{StaticResource IslaIndigoBrush}" />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding AiModels}"
                    SelectedItem="{Binding SelectedAiModel, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    FontSize="12"
                    HorizontalAlignment="Stretch" />
                <Border Grid.Column="2" Background="#16818CF8" CornerRadius="6" Padding="7,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedAiModel.ProviderName}" FontSize="10" Foreground="{StaticResource IslaIndigoBrush}" />
                </Border>
            </Grid>

            <!-- Conversation History -->
            <ScrollViewer Grid.Row="1" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AiMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="#14FFFFFF"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,8"
                                Margin="0,0,0,6">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource IslaAccentBrush}" />
                                        <TextBlock Text="•" FontSize="10" Foreground="{StaticResource IslaTextMutedBrush}" />
                                        <TextBlock Text="{Binding ModelName}" FontSize="10" Foreground="{StaticResource IslaTextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{Binding Content}"
                                        FontSize="12"
                                        Foreground="{StaticResource IslaTextPrimaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Chat Input -->
            <Grid Grid.Row="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IslaIconButtonStyle}" ToolTipService.ToolTip="Attach File (Phase 7)">
                    <FontIcon Glyph="&#xE723;" FontSize="12" />
                </Button>
                <Button Grid.Column="1" Style="{StaticResource IslaIconButtonStyle}" ToolTipService.ToolTip="Voice Input (Phase 7)">
                    <FontIcon Glyph="&#xE720;" FontSize="12" />
                </Button>
                <TextBox
                    Grid.Column="2"
                    PlaceholderText="Ask Isla AI (Ollama)..."
                    Text="{Binding AiPromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="12"
                    CornerRadius="12" />
                <Button
                    Grid.Column="3"
                    Style="{StaticResource IslaIconButtonStyle}"
                    Background="{StaticResource IslaIndigoBrush}"
                    Foreground="{StaticResource IslaVoidBrush}"
                    Command="{Binding SendAiPromptCommand}"
                    ToolTipService.ToolTip="Send">
                    <FontIcon Glyph="&#xE724;" FontSize="12" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
