<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Isla Core Palette -->
    <Color x:Key="IslaVoidBlack">#070709</Color>
    <Color x:Key="IslaSurfaceDeep">#0B0B0F</Color>
    <Color x:Key="IslaSurfaceElevated">#14141A</Color>
    <Color x:Key="IslaSurfaceCard">#1B1B23</Color>
    <Color x:Key="IslaSurfaceHover">#24242F</Color>
    <Color x:Key="IslaBorderSubtle">#1EFFFFFF</Color>
    <Color x:Key="IslaBorderHighlight">#33FFFFFF</Color>
    <Color x:Key="IslaAccentBlue">#60A5FA</Color>
    <Color x:Key="IslaAccentIndigo">#818CF8</Color>
    <Color x:Key="IslaAccentGreen">#34D399</Color>
    <Color x:Key="IslaAccentAmber">#F59E0B</Color>
    <Color x:Key="IslaAccentRose">#FB7185</Color>

    <SolidColorBrush x:Key="IslaVoidBrush" Color="{StaticResource IslaVoidBlack}" />
    <SolidColorBrush x:Key="IslaSurfaceBrush" Color="{StaticResource IslaSurfaceDeep}" />
    <SolidColorBrush x:Key="IslaElevatedBrush" Color="{StaticResource IslaSurfaceElevated}" />
    <SolidColorBrush x:Key="IslaCardBrush" Color="{StaticResource IslaSurfaceCard}" />
    <SolidColorBrush x:Key="IslaHoverBrush" Color="{StaticResource IslaSurfaceHover}" />
    <SolidColorBrush x:Key="IslaBorderBrush" Color="{StaticResource IslaBorderSubtle}" />
    <SolidColorBrush x:Key="IslaAccentBrush" Color="{StaticResource IslaAccentBlue}" />
    <SolidColorBrush x:Key="IslaIndigoBrush" Color="{StaticResource IslaAccentIndigo}" />
    <SolidColorBrush x:Key="IslaGreenBrush" Color="{StaticResource IslaAccentGreen}" />
    <SolidColorBrush x:Key="IslaAmberBrush" Color="{StaticResource IslaAccentAmber}" />
    <SolidColorBrush x:Key="IslaRoseBrush" Color="{StaticResource IslaAccentRose}" />

    <SolidColorBrush x:Key="IslaTextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="IslaTextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="IslaTextMutedBrush" Color="#64748B" />

    <LinearGradientBrush x:Key="IslaPillBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#000000" Offset="0" />
        <GradientStop Color="#050507" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="IslaCardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1A22" Offset="0" />
        <GradientStop Color="#121218" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <Style x:Key="IslaTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslaTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IslaSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslaTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IslaSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslaTextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <!-- Subtle Icon Button -->
    <Style x:Key="IslaIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource IslaTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#18FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="IslaPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource IslaTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
</ResourceDictionary>
